{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verify.adverserial.ai/schema/nodes.schema.json",
  "title": "Adverserial public node registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "issued_at", "trust", "nodes"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "const": 1 },
    "issued_at": { "type": "string", "format": "date-time" },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["distribution", "detached_signature", "note"],
      "properties": {
        "distribution": { "enum": ["https-origin", "signed"] },
        "detached_signature": { "type": "boolean" },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/node" } }
  },
  "$defs": {
    "nullableUri": {
      "oneOf": [{ "type": "string", "format": "uri" }, { "type": "null" }]
    },
    "nullableString": {
      "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "verification_method", "fresh_evidence_endpoint", "verification_command"],
      "properties": {
        "state": { "enum": ["verified-at-publication", "pending", "unavailable", "failed", "expired"] },
        "verification_method": { "type": "string", "minLength": 1 },
        "fresh_evidence_endpoint": { "$ref": "#/$defs/nullableUri" },
        "verification_command": { "$ref": "#/$defs/nullableString" },
        "verified_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "evidence_digest": { "type": "string", "pattern": "^sha256:[A-Za-z0-9_-]+$" },
        "receipt_key_id": { "type": "string", "minLength": 1 },
        "tls_spki_sha256": { "type": "string", "pattern": "^sha256:[A-Za-z0-9_-]+$" }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "verified-at-publication" } } },
          "then": {
            "required": ["verified_at", "expires_at", "evidence_digest", "receipt_key_id", "tls_spki_sha256"],
            "properties": {
              "fresh_evidence_endpoint": { "type": "string", "format": "uri" },
              "verification_command": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "display_name", "service_type", "lifecycle", "provider", "environment", "technologies", "endpoint", "model_id", "policy_ref", "release_ref", "description", "attestation"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
        "display_name": { "type": "string", "minLength": 1 },
        "service_type": { "enum": ["confidential-inference", "agent-control-plane", "witness"] },
        "lifecycle": { "enum": ["provisioning", "active", "degraded", "retired"] },
        "provider": { "type": "string", "minLength": 1 },
        "environment": { "enum": ["production", "staging", "development"] },
        "technologies": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "endpoint": { "$ref": "#/$defs/nullableUri" },
        "verification_api": { "$ref": "#/$defs/nullableUri" },
        "runtime_network": { "enum": ["private", "public"] },
        "model_id": { "$ref": "#/$defs/nullableString" },
        "policy_ref": { "$ref": "#/$defs/nullableString" },
        "release_ref": { "$ref": "#/$defs/nullableString" },
        "source_repository": { "type": "string", "format": "uri" },
        "description": { "type": "string", "minLength": 1 },
        "attestation": { "$ref": "#/$defs/attestation" },
        "activation_requirements": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      },
      "allOf": [
        {
          "if": { "properties": { "lifecycle": { "const": "active" } } },
          "then": {
            "properties": {
              "endpoint": { "type": "string", "format": "uri" },
              "policy_ref": { "type": "string", "minLength": 1 },
              "release_ref": { "type": "string", "minLength": 1 }
            }
          }
        },
        {
          "if": { "properties": { "lifecycle": { "const": "provisioning" } } },
          "then": { "required": ["activation_requirements"] }
        }
      ]
    }
  }
}
