{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verify.adverserial.ai/schema/models.schema.json",
  "title": "Adverserial public model registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "issued_at", "models"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "enum": [1, 2] },
    "issued_at": { "type": "string", "format": "date-time" },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "display_name", "served_name", "policy_ref", "description"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "display_name": { "type": "string", "minLength": 1 },
          "served_name": { "type": "string", "minLength": 1 },
          "policy_ref": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
