{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verify.adverserial.ai/schema/agent-control-plane-policy.schema.json",
  "title": "Adverserial attested agent control-plane policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "status",
    "policy_id",
    "service_type",
    "runtime",
    "required_claims",
    "workload_image_digest",
    "source"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "enum": [
        1,
        2
      ]
    },
    "status": {
      "enum": [
        "active",
        "retired"
      ]
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "service_type": {
      "const": "agent-control-plane"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "tee",
        "project_number",
        "zone",
        "service_account"
      ],
      "properties": {
        "provider": {
          "const": "google-confidential-space"
        },
        "tee": {
          "const": "GCP_INTEL_TDX"
        },
        "project_number": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "zone": {
          "type": "string",
          "minLength": 1
        },
        "service_account": {
          "type": "string",
          "format": "email"
        }
      }
    },
    "required_claims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "workload_image_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "receipt_key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kid",
        "alg",
        "public_jwk"
      ],
      "properties": {
        "kid": {
          "type": "string",
          "minLength": 1
        },
        "alg": {
          "const": "ES256"
        },
        "public_jwk": {
          "type": "object",
          "required": [
            "kty",
            "crv",
            "x",
            "y"
          ]
        }
      }
    },
    "credential_release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workload_identity_pool",
        "provider",
        "encrypted_bucket",
        "kms_key"
      ],
      "properties": {
        "workload_identity_pool": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "encrypted_bucket": {
          "type": "string",
          "pattern": "^gs://"
        },
        "kms_key": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "build_id"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "build_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "trust_note": {
      "type": "string",
      "minLength": 1
    },
    "receipt_key_trust": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "alg",
        "binding",
        "fresh_evidence_endpoint"
      ],
      "properties": {
        "model": {
          "const": "attested-per-boot"
        },
        "alg": {
          "const": "ES256"
        },
        "binding": {
          "type": "string",
          "minLength": 1
        },
        "fresh_evidence_endpoint": {
          "type": "string",
          "format": "uri"
        },
        "accepted_audiences": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "revoked_kids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kid",
          "revoked_at",
          "reason"
        ],
        "properties": {
          "kid": {
            "type": "string",
            "minLength": 16
          },
          "revoked_at": {
            "type": "string",
            "format": "date-time"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "public_jwk": {
            "type": "object"
          }
        }
      },
      "minItems": 0
    },
    "supersedes": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "version": {
            "const": 2
          }
        }
      },
      "then": {
        "required": [
          "receipt_key_trust",
          "revoked_kids"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "receipt_key"
              ]
            },
            {
              "required": [
                "credential_release"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "version": {
            "const": 1
          }
        }
      },
      "then": {
        "required": [
          "receipt_key",
          "credential_release"
        ]
      }
    }
  ]
}
